{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
    "APPLICATIONINSIGHTS_CONNECTION_STRING": "",

    "ServiceBus__ConnectionString": "<your-service-bus-connection-string>",
    "ServiceBus__QueueName": "codereview-requests",

    "AzureDevOps__OrganizationUrl": "https://dev.azure.com/your-organization",
    "AzureDevOps__PatSecretName": "ado-pat-token",

    "Llm__Endpoint": "https://your-openai.openai.azure.com/",
    "Llm__DeploymentName": "gpt-4o",
    "Llm__ApiKeySecretName": "foundry-api-key",
    "Llm__MaxTokens": "4096",
    "Llm__MaxFilesPerRequest": "10",
    "Llm__MaxLinesPerRequest": "2000",

    "KeyVault__VaultUrl": "https://your-keyvault.vault.azure.net/"
  }
}
